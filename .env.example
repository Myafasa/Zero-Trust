# Salin ke .env (atau jalankan: npm run setup) lalu ganti semua secret.
JWT_SECRET=ganti-dengan-string-acak-panjang-1
REFRESH_SECRET=ganti-dengan-string-acak-panjang-2
GATEWAY_SECRET=ganti-dengan-string-acak-panjang-3

# Kredensial Service Nilai untuk POST /auth/service
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-string-acak-panjang-4

# Jam akses perubahan & finalisasi nilai (jam lokal pada ACCESS_TZ).
# Untuk demo "deny": ACCESS_HOUR_START=0 ACCESS_HOUR_END=1 . Untuk selalu boleh: 0 dan 24.
ACCESS_HOUR_START=7
ACCESS_HOUR_END=21
ACCESS_TZ=Asia/Jakarta

DB_PATH=./db/nilai.sqlite
NILAI_URL=http://127.0.0.1:3001
TRANSKRIP_URL=http://127.0.0.1:3002
GATEWAY_URL=http://127.0.0.1:3000
