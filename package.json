{
  "name": "zero-trust-nilai",
  "version": "1.0.0",
  "description": "Sistem Nilai dengan arsitektur Zero Trust (NIST SP 800-207): API Gateway (PEP) + Service Nilai + Service Transkrip",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "seed": "node db/seed.js",
    "start:gateway": "node gateway/index.js",
    "start:nilai": "node service-nilai/index.js",
    "start:transkrip": "node service-transkrip/index.js",
    "start": "concurrently -n gateway,nilai,transkrip -c blue,green,yellow \"npm:start:gateway\" \"npm:start:nilai\" \"npm:start:transkrip\"",
    "test": "node test/e2e.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
